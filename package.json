{
  "name": "clothes-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn run services:up && yarn run wait-for-postgres && yarn run migrate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "commit": "cz",
    "test": "npm run services:up && npm run migrate && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.ts",
    "migrate": "npx drizzle-kit migrate",
    "migrate:create": "npx drizzle-kit generate",
    "services:up": "sudo docker compose -f infra/compose.yaml up -d",
    "services:stop": "sudo docker compose -f infra/compose.yaml stop",
    "services:down": "sudo docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.ts"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^18.0.10",
    "dotenv-expand": "^1000.0.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/async-retry": "^1.4.9",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "pinst": "^3.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@1.22.22"
}
